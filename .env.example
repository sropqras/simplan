# ---- Server ----
PORT=3000
NODE_ENV=development
# Public base URL of the app. Must match what you register in Google Cloud.
# Local dev: http://localhost:3000   Production: https://tasks.yourdomain.com
BASE_URL=http://localhost:3000

# ---- Session ----
# Long random string. Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=change-me

# ---- PostgreSQL ----
# Format: postgres://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgres://postgres:postgres@localhost:5432/realtime_tasks
# Set to "true" if your Postgres requires SSL (common for remote/managed DBs).
DATABASE_SSL=false

# At least one entry point must be configured: Google (standalone app) and/or Azure DevOps.

# ---- Google OAuth (standalone web app; leave empty for an Azure DevOps-only deployment) ----
# Create credentials at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI must be:  <BASE_URL>/auth/google/callback
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret

# ---- Azure DevOps extension mode (see docs/azure-devops.md) ----
# Extension secret: Marketplace publisher portal -> right-click the extension -> Certificate.
# Changes whenever the extension's scopes change.
ADO_EXTENSION_SECRET=
# Extra origins allowed to call /ado/api (comma-separated). The Marketplace CDN
# (https://<publisher>.gallerycdn.vsassets.io) is always allowed.
ADO_ALLOWED_ORIGINS=
# Secret for service-hook (webhook) passwords; defaults to ADO_EXTENSION_SECRET.
ADO_HOOK_SECRET=
# Public https URL Azure DevOps calls for service hooks (defaults to BASE_URL).
# PUBLIC_URL=https://<app>.azurewebsites.net
# Only for tests: point the ADO client at a fake server. Default https://dev.azure.com
# ADO_BASE_URL=

# ---- Azure AI Foundry (chat @ai, ticket proposals, work item summaries) ----
# Model deployment endpoint (the /openai/v1 API is appended), e.g. https://<resource>.openai.azure.com
FOUNDRY_ENDPOINT=
FOUNDRY_DEPLOYMENT=
# On App Service leave this empty and use the managed identity (needs Node 22+ for @azure/identity).
# FOUNDRY_API_KEY is a local-dev fallback only.
FOUNDRY_API_KEY=
# FOUNDRY_TIMEOUT_MS=60000
# AI_REPLIES_PER_HOUR=30
