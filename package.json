{
  "name": "realtime-tasks",
  "version": "0.1.0",
  "description": "Real-time event/task management platform: live Kanban dashboards, project chat rooms, AI task triage, Google auth.",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "db:init": "node scripts/init-db.js",
    "test": "node --test --test-concurrency=1 \"test/*.test.js\"",
    "start:azure": "node scripts/init-db.js && node src/server.js"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@azure/identity": "^4.14.1",
    "connect-pg-simple": "^9.0.1",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-session": "^1.18.0",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "pg": "^8.12.0",
    "socket.io": "^4.7.5",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "socket.io-client": "^4.8.3"
  }
}
